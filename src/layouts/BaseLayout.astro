---
import ClientBehaviors from '../components/ClientBehaviors.astro';
import CardFloat3D from '../components/CardFloat3D.astro';
import DocumentLayout from './DocumentLayout.astro';
import i18n from '../data/i18n.json';
import { routePath } from '../lib/siteRoutes';

export interface Props {
  title: string;
  description?: string;
  lang: 'zh' | 'en';
  alternateZhUrl?: string;
  alternateEnUrl?: string;
}

const { title, description = '', lang, alternateZhUrl, alternateEnUrl } = Astro.props;
const isZh = lang === 'zh';
const basePath = isZh ? '' : '/en';
const profileHomePath = isZh ? '/profile' : '/en/profile';
const labels = i18n.nav[lang];
const buildDate = new Date().toLocaleDateString(isZh ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const pathWithoutLocale = Astro.url.pathname.replace(/^\/en(?:\/|$)/, '/').replace(/\/+$/, '');
const currentPage = pathWithoutLocale.replace(/^\/+/, '');
const pageKey = currentPage === '' || currentPage === 'index' ? '' : currentPage;
const isPage = (key: string) => pageKey === key;
const zhUrl = alternateZhUrl ?? (pageKey ? `/${pageKey}` : '/');
const enUrl = alternateEnUrl ?? (pageKey ? `/en/${pageKey}` : '/en/');
---

<DocumentLayout
  lang={lang}
  title={title}
  description={description}
  canonicalPath={Astro.url.pathname}
  alternatePath={isZh ? enUrl : zhUrl}
  ogImagePath="/assets/avatar.jpg"
  faviconPath="/assets/avatar.jpg"
  bodyClass="resume-site"
>
  <a href="#main" class="skip-link">{isZh ? '跳到主要内容' : 'Skip to content'}</a>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href={`${profileHomePath}/`} aria-label={isZh ? '回到首页' : 'Home'}>
        <span class="brand-mark">{isZh ? 'FX' : 'XF'}</span>
        <span>{isZh ? '方绪杰' : 'Xujie Fang'}</span>
      </a>
      <nav class="nav-links" id="navLinks" aria-label={isZh ? '个人站导航' : 'Profile navigation'}>
        <a
          href={`${profileHomePath}/`}
          class:list={[{ active: isPage('profile') }]}
          aria-current={isPage('profile') ? 'page' : undefined}>{isZh ? '个人简历' : 'Profile'}</a
        >
        <a href={`${profileHomePath}/#projects`}>{labels.projects}</a>
        <a
          href={`${basePath}/evidence`}
          class:list={[{ active: isPage('evidence') }]}
          aria-current={isPage('evidence') ? 'page' : undefined}>{labels.evidence}</a
        >
        <a
          href={`${basePath}/materials`}
          class:list={[{ active: isPage('materials') }]}
          aria-current={isPage('materials') ? 'page' : undefined}>{labels.materials}</a
        >
        <a href={routePath('writing', lang)}>{labels.blog}</a>
        <a class="mobile-link" href={routePath('resume-onepage', lang)}>{labels.onepage}</a>
        <a class="mobile-link" href={`${profileHomePath}/#contact`}>{labels.contact}</a>
      </nav>
      <div class="nav-actions">
        <div class="lang-switch">
          <a href={zhUrl} data-lang="zh" class:list={[{ active: isZh }]}>中文</a>
          <span class="sep">|</span>
          <a href={enUrl} data-lang="en" class:list={[{ active: !isZh }]}>EN</a>
        </div>
        <button
          class="icon-btn"
          id="layoutToggle"
          type="button"
          aria-pressed="false"
          aria-label={isZh ? '切换极简模式' : 'Toggle minimal mode'}
          title={isZh ? '极简模式' : 'Minimal'}
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M9 4v16"></path></svg
          >
        </button>
        <button
          class="icon-btn"
          id="themeToggle"
          data-theme-toggle
          type="button"
          aria-pressed="false"
          aria-label={isZh ? '切换明暗模式' : 'Toggle color mode'}
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"
            ></path></svg
          >
        </button>
        <button
          class="icon-btn menu-btn"
          id="menuToggle"
          type="button"
          aria-expanded="false"
          aria-controls="navLinks"
          aria-label={isZh ? '打开导航菜单' : 'Open navigation menu'}
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
          >
        </button>
        <a class:list={['btn', { active: isPage('resume-onepage') }]} href={`${basePath}/resume-onepage`}
          >{labels.onepage}</a
        >
        <a class="btn primary" href={`${profileHomePath}/#contact`}>{labels.contact}</a>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1"><slot /></main>

  <CardFloat3D />
  <ClientBehaviors />
  <footer role="contentinfo">
    <div class="container profile-footer">
      <span>&copy; 2026 {isZh ? '方绪杰' : 'Xujie Fang'} · {isZh ? '更新于' : 'Updated'} {buildDate}</span>
      <a href={routePath('brand-home', lang)}
        >{isZh ? '硅基余烬 · 主站' : 'silicon-embers · Home'} <span aria-hidden="true">↗</span></a
      >
    </div>
  </footer>
</DocumentLayout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.84);
    border-bottom: 1px solid rgba(226, 231, 238, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  [data-theme='dark'] .site-header {
    background: rgba(7, 6, 5, 0.82);
    border-bottom-color: rgba(242, 223, 189, 0.14);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    gap: 14px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    color: var(--primary);
    white-space: nowrap;
  }
  .brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(201, 162, 39, 0.42);
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--primary);
    font-size: 15px;
  }
  [data-theme='dark'] .brand-mark {
    border-color: rgba(232, 174, 98, 0.56);
    background: var(--accent-soft);
    color: #f4d49b;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
  }
  .nav-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    white-space: nowrap;
    transition: color 160ms ease;
  }
  .nav-links a:hover {
    color: var(--primary);
  }
  .nav-links a.active {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .nav-links .mobile-link {
    display: none;
  }
  .nav-actions .btn.active {
    border-color: rgba(201, 162, 39, 0.5);
    background: var(--accent-soft);
  }
  .icon-btn {
    display: inline-grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--primary);
    cursor: pointer;
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }
  .icon-btn:hover,
  .icon-btn[aria-pressed='true'] {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .menu-btn {
    display: none;
  }
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 700;
  }
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    min-width: 32px;
    padding: 3px 6px;
    border-radius: 4px;
    color: var(--muted);
  }
  .lang-switch a:hover {
    color: var(--primary);
  }
  .lang-switch a.active {
    color: var(--primary);
    background: var(--accent-soft);
  }
  .lang-switch .sep {
    color: var(--line);
  }
  .profile-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
    text-align: left;
  }
  .profile-footer a {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    gap: 8px;
  }
  .profile-footer a:hover {
    color: var(--primary);
  }
  @media (max-width: 1100px) {
    .nav {
      position: relative;
      gap: 12px;
      min-height: 64px;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - 88px);
      overflow-y: auto;
      align-items: stretch;
      flex-direction: column;
      gap: 2px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--paper);
      box-shadow: var(--shadow);
    }
    .nav-links.open {
      display: flex;
    }
    .nav-links a {
      padding: 10px 12px;
      border-radius: 6px;
    }
    .nav-links .mobile-link {
      display: inline-flex;
    }
    .nav-links a:hover {
      background: var(--accent-soft);
    }
    .menu-btn {
      display: inline-grid;
    }
    .nav-actions > .btn {
      display: none;
    }
  }

  .skip-link {
    position: fixed;
    top: -100%;
    left: 8px;
    z-index: 10000;
    padding: 8px 16px;
    background: var(--primary);
    color: var(--paper);
    border-radius: 0 0 var(--radius) var(--radius);
    font-size: 14px;
    font-weight: 700;
  }
  .footer-admin {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s;
  }
  .footer-admin:hover {
    text-decoration-color: var(--accent);
  }
  .skip-link:focus {
    top: 0;
  }
  @media (max-width: 460px) {
    .nav {
      gap: 8px;
    }
    .brand {
      gap: 8px;
    }
    .brand-mark {
      width: 36px;
      height: 36px;
    }
    .nav-actions {
      gap: 6px;
    }
    .icon-btn {
      width: 38px;
      height: 38px;
    }
  }
</style>
