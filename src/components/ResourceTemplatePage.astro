---
import type { ResourceTemplate } from '../data/siliconAshesResources';
import type { SiliconEmbersLang } from '../data/siliconEmbersHome';
import ActionButton from './silicon-embers/ActionButton.astro';

export interface Props {
  lang: SiliconEmbersLang;
  template: ResourceTemplate;
}

const { lang, template } = Astro.props;
const isZh = lang === 'zh';
const data = template[lang];
const resourcesHref = isZh ? '/silicon-ashes/resources/' : '/en/silicon-ashes/resources/';

const copy = isZh
  ? {
      purpose: '用途',
      sections: '包含模块',
      checklist: '使用前检查',
      copy: '可复制模板',
      back: '返回资源中心',
    }
  : {
      purpose: 'Purpose',
      sections: 'Sections',
      checklist: 'Before use',
      copy: 'Copyable template',
      back: 'Back to resources',
    };
---

<article class="resource-template">
  <header class="template-hero">
    <p class="eyebrow">{data.eyebrow}</p>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>
    <ul class="meta-list">
      {data.meta.map((item) => <li>{item}</li>)}
    </ul>
  </header>

  <section class="purpose" aria-labelledby="purpose-title">
    <div class="section-head">
      <p class="kicker">why</p>
      <h2 id="purpose-title">{copy.purpose}</h2>
    </div>
    <p>{data.purpose}</p>
  </section>

  <section class="layout-grid" aria-label={isZh ? '模板结构' : 'Template structure'}>
    <article>
      <h2>{copy.sections}</h2>
      <ul>
        {data.sections.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article>
      <h2>{copy.checklist}</h2>
      <ul>
        {data.checklist.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="template-block" aria-labelledby="template-title">
    <div class="section-head wide">
      <p class="kicker">copy</p>
      <h2 id="template-title">{copy.copy}</h2>
    </div>
    <pre><code>{data.template}</code></pre>
  </section>

  <footer class="template-return">
    <ActionButton href={resourcesHref}>{copy.back}</ActionButton>
  </footer>
</article>

<style>
  .resource-template {
    width: min(100%, 1120px);
    margin: 0 auto;
    padding-bottom: var(--space-section);
  }

  .template-hero {
    padding: var(--page-head-top) 0 var(--page-head-bottom);
  }

  h1,
  h2,
  p {
    overflow-wrap: anywhere;
  }

  h1,
  h2 {
    margin: 0;
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 780;
    letter-spacing: -0.025em;
    line-height: var(--page-title-leading);
    text-wrap: balance;
  }

  h1 {
    max-width: 20ch;
    margin-top: 16px;
    font-size: var(--display-page-size);
  }

  .lead {
    max-width: 760px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: var(--lead-size);
    line-height: 1.75;
  }

  .meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .meta-list li {
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 6px 10px;
    color: var(--muted);
    font-size: 13px;
  }

  .purpose,
  .layout-grid,
  .template-block {
    border-top: 1px solid var(--line);
    padding: var(--space-section) 0;
  }

  .section-head {
    display: block;
    margin-bottom: 0;
  }

  .section-head h2 {
    margin-top: 12px;
    font-size: var(--section-title-size);
  }

  .section-head.wide {
    max-width: 840px;
  }

  .purpose > p {
    max-width: 790px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.84;
  }

  .layout-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .layout-grid article {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px;
    background: var(--surface);
  }

  .layout-grid h2 {
    font-size: 26px;
  }

  .layout-grid ul {
    display: grid;
    gap: 11px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .layout-grid li {
    position: relative;
    padding-left: 18px;
    color: var(--muted);
    line-height: 1.64;
  }

  .layout-grid li::before {
    content: '';
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 6px;
    height: 6px;
    background: var(--ember-strong);
  }

  .template-block pre {
    overflow-x: auto;
    margin: 30px 0 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 26px;
    background: var(--surface-strong);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .template-block code {
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.76;
  }

  .template-return {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  @media (max-width: 760px) {
    h1 {
      margin-top: 12px;
    }

    .lead {
      margin-top: 14px;
      font-size: 16px;
      line-height: 1.75;
    }

    .purpose > p,
    .layout-grid li {
      font-size: 16px;
      line-height: 1.75;
    }

    .layout-grid {
      grid-template-columns: 1fr;
    }

    .layout-grid article,
    .template-block pre {
      padding: 20px;
    }

    .layout-grid h2 {
      font-size: 18px;
    }

    .template-block code {
      font-size: 13px;
      line-height: 1.75;
    }
  }

  @media (max-width: 360px) {
    .meta-list li {
      font-size: 12px;
    }
  }
</style>
