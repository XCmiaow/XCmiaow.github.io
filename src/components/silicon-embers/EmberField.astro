---
import Ferrofluid from './Ferrofluid.astro';

const discHalves = [
  { depth: 'depth-rear', disc: 'disc-back', sweep: 1 },
  { depth: 'depth-front', disc: 'disc-front', sweep: 0 },
];
---

<div class="ember-stage" aria-hidden="true">
  <div class="depth-far">
    <div class="cosmic-grain"></div>
    <span class="orbital-guide guide-outer"></span>
    <span class="orbital-guide guide-inner"></span>
  </div>

  <div class="depth-fluid">
    <Ferrofluid
      colors={['#c46b3f', '#7f3f2b', '#3d2119', '#14110e']}
      backgroundColor="transparent"
      speed={0.003}
      scale={1.7}
      turbulence={1.22}
      fluidity={0.1}
      rimWidth={0.34}
      sharpness={2.05}
      shimmer={1.22}
      glow={2.28}
      flowDirection="down"
      opacity={0.74}
      mouseInteraction={true}
      mouseStrength={0.42}
      mouseRadius={0.35}
      mouseDampening={0.24}
      dpr={1}
      mixBlendMode="normal"
      className="magnetic-fluid"
    />
  </div>

  <div class="black-hole-scene">
    <div class="gravity-veil"></div>

    {
      discHalves.map(({ depth, disc, sweep }) => (
        <div class={depth}>
          <svg class:list={['accretion-disc', disc]} viewBox="0 0 1000 260" fill="none" focusable="false">
            <defs>
              <linearGradient
                id={`accretion-${disc}`}
                x1="70"
                y1="130"
                x2="930"
                y2="130"
                gradientUnits="userSpaceOnUse"
              >
                <stop offset="0" stop-color="var(--disc-edge)" stop-opacity="0.25" />
                <stop offset="0.18" stop-color="var(--disc-warm)" stop-opacity="0.8" />
                <stop offset="0.38" stop-color="var(--disc-hot)" />
                <stop offset="0.65" stop-color="var(--disc-warm)" stop-opacity="0.85" />
                <stop offset="1" stop-color="var(--disc-edge)" stop-opacity="0.2" />
              </linearGradient>
            </defs>
            <g stroke={`url(#accretion-${disc})`} stroke-linecap="round">
              {['disc-glow', 'disc-body', 'disc-rim'].map((layer) => (
                <path class={layer} d={`M 70 130 A 430 76 0 0 ${sweep} 930 130`} />
              ))}
              <path class="disc-filament" d={`M 88 130 A 412 68 0 0 ${sweep} 912 130`} />
            </g>
          </svg>
        </div>
      ))
    }

    <div class="depth-event">
      <div class="photon-ring"></div>
      <div class="event-horizon"></div>
    </div>
  </div>

  <canvas data-ember-canvas></canvas>
  <div class="depth-near"><span class="foreground-dust"></span></div>
</div>

<style>
  .ember-stage {
    --hole-x: 50%;
    --hole-y: 50%;
    --hole-size: min(42vw, 560px);

    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 94%, transparent 100%);
  }

  .ember-stage::before,
  .ember-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ember-stage::before {
    z-index: 1;
    background:
      radial-gradient(
        circle at var(--hole-x) var(--hole-y),
        transparent 0 13%,
        rgba(180, 105, 50, 0.05) 31%,
        transparent 59%
      ),
      linear-gradient(90deg, rgba(7, 6, 4, 0.97), rgba(7, 6, 4, 0.5) 31%, transparent 61%);
  }

  .ember-stage::after {
    z-index: 6;
    background:
      radial-gradient(circle at 0 0, rgba(7, 6, 4, 0.9), rgba(7, 6, 4, 0.34) 24%, transparent 48%),
      radial-gradient(circle at 100% 100%, rgba(7, 6, 4, 0.72), rgba(7, 6, 4, 0.2) 22%, transparent 46%);
  }

  .depth-far,
  .depth-near,
  canvas {
    position: absolute;
    inset: 0;
  }

  .depth-far {
    z-index: 0;
  }

  .cosmic-grain {
    position: absolute;
    inset: 8% 0 10% 14%;
    background-image:
      radial-gradient(circle at 14% 28%, rgba(244, 220, 177, 0.34) 0 0.5px, transparent 1px),
      radial-gradient(circle at 68% 18%, rgba(230, 183, 124, 0.26) 0 0.65px, transparent 1.1px),
      radial-gradient(circle at 87% 72%, rgba(244, 220, 177, 0.2) 0 0.55px, transparent 1.1px),
      radial-gradient(circle at 43% 81%, rgba(210, 137, 77, 0.24) 0 0.7px, transparent 1.25px);
    background-size:
      163px 149px,
      211px 197px,
      241px 223px,
      179px 191px;
    opacity: 0.34;
    mask-image: radial-gradient(ellipse at var(--hole-x) var(--hole-y), #000 0 34%, transparent 76%);
  }

  .orbital-guide {
    position: absolute;
    top: var(--hole-y);
    left: var(--hole-x);
    border: 1px solid rgba(225, 176, 112, 0.075);
    border-radius: 50%;
    opacity: 0.22;
    transform: translate(-50%, -50%) rotate(-12deg) scaleY(0.72);
  }

  .guide-outer {
    width: calc(var(--hole-size) * 1.46);
    aspect-ratio: 1;
  }

  .guide-inner {
    width: calc(var(--hole-size) * 0.92);
    aspect-ratio: 1;
    border-style: dashed;
    border-color: rgba(225, 176, 112, 0.055);
    transform: translate(-50%, -50%) rotate(-12deg) scaleY(0.72) rotate(7deg);
  }

  canvas {
    z-index: 8;
    width: 100%;
    height: 100%;
  }

  .black-hole-scene {
    --disc-edge: #a95b2d;
    --disc-warm: #dc924a;
    --disc-hot: #ffe5ae;

    position: absolute;
    top: var(--hole-y);
    left: var(--hole-x);
    z-index: 3;
    width: var(--hole-size);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }

  .gravity-veil,
  .depth-rear,
  .depth-event,
  .depth-fluid,
  .depth-front,
  .accretion-disc,
  .photon-ring,
  .event-horizon {
    position: absolute;
  }

  .gravity-veil {
    inset: -28%;
    z-index: -1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(0, 0, 0, 0.95) 0 14%, rgba(0, 0, 0, 0.48) 24%, transparent 45%),
      radial-gradient(ellipse, rgba(178, 100, 45, 0.14) 0 13%, rgba(74, 42, 23, 0.1) 34%, transparent 67%);
    filter: blur(23px);
    opacity: 0.9;
    transform: rotate(-12deg) scale(1.2, 0.82);
    animation: gravity-breathe 18s ease-in-out infinite;
  }

  .depth-rear,
  .depth-event,
  .depth-front {
    inset: 0;
  }

  .depth-rear {
    z-index: 2;
  }

  .depth-event {
    z-index: 4;
  }

  .depth-fluid {
    inset: -8%;
    z-index: 2;
    pointer-events: none;
    overflow: hidden;
    filter: saturate(0.82) contrast(1.32) brightness(0.78);
    opacity: 0.96;
    -webkit-mask-image:
      radial-gradient(
        ellipse calc(var(--hole-size) * 2.28) calc(var(--hole-size) * 1.04) at var(--hole-x) var(--hole-y),
        transparent 0 76%,
        rgba(0, 0, 0, 0.08) 90%,
        #000 100%
      ),
      linear-gradient(90deg, transparent 0%, #000 11%, #000 92%, transparent 100%);
    mask-image:
      radial-gradient(
        ellipse calc(var(--hole-size) * 2.28) calc(var(--hole-size) * 1.04) at var(--hole-x) var(--hole-y),
        transparent 0 76%,
        rgba(0, 0, 0, 0.08) 90%,
        #000 100%
      ),
      linear-gradient(90deg, transparent 0%, #000 11%, #000 92%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    animation: fluid-field-drift 520s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .depth-fluid::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(circle at 20% 28%, rgba(150, 79, 49, 0.12), transparent 28rem),
      radial-gradient(circle at 82% 72%, rgba(30, 21, 17, 0.2), transparent 32rem);
    opacity: 0.78;
    animation: fluid-field-breathe 420s ease-in-out infinite;
  }

  .depth-fluid :global(.magnetic-fluid) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 1;
    filter: saturate(0.9) contrast(1.24) brightness(0.92);
  }

  .depth-fluid :global(.magnetic-fluid canvas) {
    opacity: 1;
  }

  @keyframes fluid-field-drift {
    0%,
    100% {
      opacity: 0.88;
      transform: translate3d(-0.35%, -0.12%, 0) scale(1.008);
    }
    50% {
      opacity: 1;
      transform: translate3d(0.55%, 0.24%, 0) scale(1.016);
    }
  }

  @keyframes fluid-field-breathe {
    0%,
    100% {
      opacity: 0.72;
    }
    50% {
      opacity: 0.96;
    }
  }

  .depth-front {
    z-index: 6;
  }

  .accretion-disc {
    top: 50%;
    left: 50%;
    display: block;
    width: 128%;
    height: auto;
    aspect-ratio: 1000 / 260;
    overflow: visible;
    /* Both halves share one projection; the opaque horizon supplies the occlusion. */
    transform: translate(-50%, -50%) rotate(-12deg);
  }

  .disc-back {
    opacity: 0.64;
  }

  .disc-front {
    opacity: 0.96;
  }

  .disc-glow {
    stroke-width: 22;
    filter: blur(7px);
    opacity: 0.32;
    animation: disc-shimmer 18s ease-in-out infinite;
  }

  .disc-body {
    stroke-width: 7;
    filter: blur(1.5px);
    opacity: 0.5;
  }

  .disc-rim {
    stroke-width: 1.6;
    opacity: 0.9;
  }

  .disc-filament {
    stroke-width: 1;
    opacity: 0.24;
  }

  .photon-ring {
    top: 50%;
    left: 50%;
    width: 31%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(
      from 218deg,
      transparent 0 8%,
      rgba(244, 180, 101, 0.18) 18%,
      rgba(255, 230, 174, 0.36) 26%,
      rgba(183, 94, 40, 0.08) 43%,
      transparent 58% 100%
    );
    filter: blur(0.35px);
    mask-image: radial-gradient(circle closest-side, transparent 0 95%, #000 96% 97%, transparent 99%);
    transform: translate(-50%, -50%);
    animation: photon-breathe 16s ease-in-out infinite;
  }

  .event-horizon {
    top: 50%;
    left: 50%;
    width: 29%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 48% 46%, #030302 0 58%, #080604 82%, #010101 100%);
    box-shadow:
      inset 0 0 16px rgba(0, 0, 0, 0.96),
      0 0 0 1px rgba(238, 183, 111, 0.09),
      0 0 12px rgba(0, 0, 0, 0.78);
    transform: translate(-50%, -50%);
  }

  .event-horizon::after {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, #010101 0 68%, rgba(2, 2, 1, 0.9) 90%);
  }

  .depth-near {
    z-index: 9;
    overflow: hidden;
    opacity: 0.68;
  }

  .foreground-dust {
    position: absolute;
    top: 24%;
    right: 6%;
    width: 28%;
    height: 48%;
    background-image:
      radial-gradient(circle at 22% 20%, rgba(255, 218, 159, 0.55) 0 0.7px, transparent 1.8px),
      radial-gradient(circle at 78% 39%, rgba(205, 123, 55, 0.42) 0 1px, transparent 2.4px),
      radial-gradient(circle at 47% 81%, rgba(244, 220, 177, 0.38) 0 0.8px, transparent 2px);
    filter: blur(0.25px);
    opacity: 0.5;
    animation: near-drift 19s ease-in-out infinite;
  }

  @keyframes disc-shimmer {
    0%,
    100% {
      opacity: 0.26;
    }
    50% {
      opacity: 0.38;
    }
  }

  @keyframes photon-breathe {
    0%,
    100% {
      opacity: 0.86;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes gravity-breathe {
    0%,
    100% {
      opacity: 0.78;
      transform: rotate(-12deg) scale(1.17, 0.8);
    }
    50% {
      opacity: 0.94;
      transform: rotate(-10.5deg) scale(1.21, 0.84);
    }
  }

  @keyframes near-drift {
    0%,
    100% {
      opacity: 0.36;
      transform: translate3d(0, 0, 0);
    }
    50% {
      opacity: 0.58;
      transform: translate3d(-6px, 4px, 0);
    }
  }

  @media (max-width: 960px) {
    .ember-stage {
      --hole-size: min(50vw, 460px);

      opacity: 0.9;
    }
  }

  @media (max-width: 720px) {
    .ember-stage {
      --hole-size: min(78vw, 320px);

      opacity: 0.88;
      mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    }

    .ember-stage::after {
      background: radial-gradient(circle at var(--hole-x) var(--hole-y), transparent 0 34%, rgba(7, 6, 4, 0.08) 70%);
    }

    .accretion-disc {
      width: 112%;
    }

    .guide-outer,
    .guide-inner,
    .foreground-dust {
      display: none;
    }

    .depth-fluid {
      inset: -10%;
      opacity: 0.92;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gravity-veil,
    .disc-glow,
    .photon-ring,
    .foreground-dust,
    .depth-fluid,
    .depth-fluid::before {
      animation: none;
    }
  }
</style>

<script>
  import './emberFieldCanvas';
</script>
