---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProfile } from '../../lib/resumeData';
import type { SiteLang } from '../../data/resumeCatalog';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const data = getProfile(lang);
const isZh = lang === 'zh';
const base = isZh ? '' : '/en';
const copy = isZh
  ? {
      title: `${data.person.name} | 林产化工本科生 | 数学建模与 AI 工具链`,
      description: `${data.person.name}，${data.education.school}${data.education.major}本科生，GPA ${data.education.gpa}。`,
      context: `${data.education.school} · ${data.education.college} · ${data.education.major}`,
      subtitle: '林产化工本科生 · 数学建模与 AI 科研工具',
      lead: `GPA ${data.education.gpa}，班级第 ${data.education.rankClass}，专业第 ${data.education.rankMajor}。学习化学与工程，用建模、编程和 AI 工具解决具体问题。`,
      about: '个人简介',
      education: '教育背景',
      honors: '获奖与荣誉',
      skills: '技能结构',
      projects: '项目与实践',
      experience: '学生工作与服务',
      research: '研究兴趣',
      evidence: '查看证明材料',
      materials: '材料中心',
      generalResume: '通用一页简历',
      level: { international: '国际', national: '国家', provincial: '省级', university: '校级', college: '院级' },
    }
  : {
      title: `${data.person.name} | Chemical Engineering | Modeling & AI Workflows`,
      description: `${data.person.name}, ${data.education.major} undergraduate at ${data.education.school}, GPA ${data.education.gpa}.`,
      context: `${data.education.major} · ${data.education.college} · ${data.education.school}`,
      subtitle: 'Chemical engineering undergraduate · Modeling & AI research tools',
      lead: `GPA ${data.education.gpa}, ranked ${data.education.rankClass}st in class and ${data.education.rankMajor}nd in major. Building from chemistry and engineering fundamentals toward modeling, programming, and AI-assisted research workflows.`,
      about: 'About',
      education: 'Education',
      honors: 'Awards & Honors',
      skills: 'Skills',
      projects: 'Projects & Practice',
      experience: 'Leadership & Service',
      research: 'Research Interests',
      evidence: 'View evidence',
      materials: 'Materials hub',
      generalResume: 'General resume',
      level: {
        international: 'International',
        national: 'National',
        provincial: 'Provincial',
        university: 'University',
        college: 'College',
      },
    };
---

<BaseLayout title={copy.title} description={copy.description} lang={lang}>
  <section class="hero" id="about">
    <div class="container profile-hero">
      <div>
        <p class="eyebrow">{copy.context}</p>
        <h1>{data.person.name}</h1>
        <p class="subtitle">{copy.subtitle}</p>
        <p class="lead">{copy.lead}</p>
        <div class="hero-actions no-print">
          <a class="btn primary" href="#honors">{copy.honors}</a>
          <a class="btn" href={`${base}/resume-onepage`}>{copy.generalResume}</a>
          <a class="btn" href={`${base}/materials`}>{copy.materials}</a>
        </div>
      </div>
      <aside class="profile-card" id="contact">
        <img src={data.person.avatar} alt={data.person.name} width="88" height="88" loading="eager" />
        <div class="profile-card-copy">
          <strong>{data.person.name}</strong>
          <span>{data.person.tagline}</span>
          <a href={`mailto:${data.person.email}`}>{data.person.email}</a>
          <a href={`https://${data.person.github}`}>{data.person.github}</a>
        </div>
      </aside>
    </div>
  </section>

  <div class="container profile-sections">
    <nav class="section-nav" aria-label={isZh ? '简历章节' : 'Profile sections'}>
      <a href="#education">{copy.education}</a>
      <a href="#honors">{copy.honors}</a>
      <a href="#skills">{copy.skills}</a>
      <a href="#projects">{copy.projects}</a>
      <a href="#experience">{copy.experience}</a>
      <a href="#research">{copy.research}</a>
    </nav>
    <section id="education">
      <h2>{copy.education}</h2>
      <article class="panel">
        <h3>{data.education.school} · {data.education.college}</h3>
        <p>{data.education.major} · {data.education.degree} · {data.education.period}</p>
        <dl class="education-stats">
          <div><dt>GPA</dt><dd>{data.education.gpa}</dd></div>
          <div><dt>{isZh ? '班级排名' : 'Class rank'}</dt><dd>{data.education.rankClass}</dd></div>
          <div><dt>{isZh ? '专业排名' : 'Major rank'}</dt><dd>{data.education.rankMajor}</dd></div>
        </dl>
      </article>
    </section>

    <section id="honors">
      <div class="section-line"><h2>{copy.honors}</h2><a href={`${base}/evidence`}>{copy.evidence}</a></div>
      <div class="award-list">
        {
          data.achievements.map((item) => (
            <article class="compact-award">
              <p class="eyebrow">
                {item.period} · {copy.level[item.level]}
              </p>
              <h3>
                {item.evidenceIds.length ? (
                  <a href={`${base}/evidence/#${item.evidenceIds[0]}`}>
                    {item.title}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                ) : (
                  item.title
                )}
              </h3>
            </article>
          ))
        }
      </div>
    </section>

    <section id="skills">
      <h2>{copy.skills}</h2>
      <div class="skill-list">
        {
          data.skills.map((item) => (
            <article class="skill-line">
              <h3>{item.title}</h3>
              <p>{item.items.join(' · ')}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="projects">
      <h2>{copy.projects}</h2>
      <div class="project-list">
        {
          data.projects.map((item) => (
            <article class="project-row">
              <h3>
                <a href={item.href}>{item.title}</a>
              </h3>
              <p>{item.summary}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="experience">
      <h2>{copy.experience}</h2>
      <div class="card-grid">
        {
          data.experience.map((item) => (
            <article class="panel">
              <>
                <p class="eyebrow">{item.period}</p>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
              </>
            </article>
          ))
        }
      </div>
      <ul>{data.service.map((item) => <li>{item.summary}</li>)}</ul>
    </section>

    <section id="research">
      <h2>{copy.research}</h2>
      <p class="lead">{data.research.tagline}</p><p>{data.research.summary}</p>
      <ul class="research-tags">
        {data.research.areas.map((item) => <li>{item.title}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .profile-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .profile-card,
  .panel {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 1.5rem;
  }
  .profile-card {
    display: grid;
    gap: 1.25rem;
    scroll-margin-top: 100px;
  }
  .profile-card-copy {
    display: grid;
    min-width: 0;
    gap: 0.55rem;
    font-size: 0.88rem;
  }
  .profile-card-copy strong {
    font-size: 1.05rem;
    color: var(--primary);
  }
  .profile-card-copy span {
    color: var(--muted);
  }
  .profile-card-copy a {
    min-height: 28px;
    overflow-wrap: anywhere;
  }
  .profile-card-copy a:hover,
  .compact-award a:hover,
  .project-row a:hover {
    color: var(--secondary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .profile-card img {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
  }
  .profile-sections {
    display: grid;
    gap: 3.5rem;
    padding-block: 0 5rem;
  }
  .section-nav {
    display: flex;
    overflow-x: auto;
    gap: 1.5rem;
    border-block: 1px solid var(--border);
    padding-block: 8px;
    scrollbar-width: thin;
  }
  .section-nav a {
    display: inline-flex;
    flex-shrink: 0;
    min-height: 44px;
    align-items: center;
    color: var(--muted);
    font-size: 0.84rem;
  }
  .section-nav a:hover {
    color: var(--primary);
  }
  .education-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }
  .education-stats dt {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .education-stats dd {
    margin: 4px 0 0;
    color: var(--primary);
    font-size: 1.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
  .profile-sections > section {
    padding: 0;
  }
  .section-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .section-line h2 {
    margin: 0;
  }
  .section-line > a {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    color: var(--secondary);
    font-size: 0.85rem;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .award-list,
  .skill-list,
  .project-list {
    display: grid;
    border-top: 1px solid var(--border);
  }
  .award-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
  }
  .compact-award,
  .skill-line,
  .project-row {
    border-bottom: 1px solid var(--border);
    padding: 1.15rem 0;
  }
  .compact-award {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    align-items: baseline;
  }
  .compact-award a {
    display: inline-block;
    min-height: 28px;
  }
  .compact-award a span {
    color: var(--secondary);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .compact-award .eyebrow,
  .compact-award h3,
  .skill-line h3,
  .skill-line p,
  .project-row h3,
  .project-row p {
    margin: 0;
  }
  .skill-line,
  .project-row {
    display: grid;
    grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .skill-line p,
  .project-row p {
    color: var(--muted);
  }
  .project-row h3 a {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
  }
  .research-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .research-tags li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.42rem 0.75rem;
    color: var(--secondary);
    font-size: 0.88rem;
  }
  .panel h3 {
    margin-top: 0;
  }
  .panel p {
    color: var(--muted);
  }
  .panel h3 a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  .eyebrow,
  .research-tags {
    color: var(--secondary);
    font-size: 0.9rem;
  }
  @media (max-width: 720px) {
    .profile-sections {
      gap: 3rem;
    }
    .profile-hero {
      grid-template-columns: 1fr;
    }
    .profile-card {
      grid-template-columns: 72px minmax(0, 1fr);
      align-items: start;
      padding: 1.1rem;
      gap: 1rem;
    }
    .profile-card img {
      width: 72px;
      height: 72px;
    }
    .award-list {
      grid-template-columns: 1fr;
    }
    .compact-award,
    .skill-line,
    .project-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
